{
  "name": "mesozoic-atlas",
  "version": "0.1.0",
  "description": "中生代の広大なワールドを手続き的に生成するアトラス／ボクセル探索アプリ",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node tools/serve.mjs",
    "bundle": "node tools/bundle.mjs",
    "dev": "node tools/serve.mjs --port 8080 --open",
    "render": "node tools/render.mjs",
    "export": "node tools/export-scene.mjs",
    "icons": "node tools/make-icons.mjs",
    "sprites": "node tools/sprites.mjs",
    "test": "node tools/verify.mjs",
    "uitest": "node tools/uitest.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
